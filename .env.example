# Copia este archivo como .env.local y completa los valores reales.
# Nunca subas .env.local al repositorio.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://www.solucionesdys.cl

# --- Resend (correos del formulario) ---
RESEND_API_KEY=

# --- Upstash Redis (rate limit y caché de farmacias) ---
# https://console.upstash.com → Redis → tu base → REST API.
# Si la creas desde Vercel Marketplace, las variables KV_REST_API_URL /
# KV_REST_API_TOKEN que agrega la integración también funcionan.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
