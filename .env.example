# Copia este archivo como .env.local y completa los valores reales.
# Nunca subas .env.local al repositorio.

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://www.solucionesdys.cl

# --- Resend (correos del formulario) ---
RESEND_API_KEY=

# --- Upstash Redis (rate limit y caché de farmacias) ---
# https://console.upstash.com → Redis → tu base → REST API.
# Si la creas desde Vercel Marketplace, las variables KV_REST_API_URL /
# KV_REST_API_TOKEN que agrega la integración también funcionan.
KV_REST_API_READ_ONLY_TOKEN=
KV_REST_API_TOKEN=
KV_REST_API_URL=
KV_URL=
REDIS_URL=

# --- Cloudflare Turnstile (captcha del formulario) ---
# https://dash.cloudflare.com → Turnstile → Add site (modo "Managed").
# Para pruebas locales Cloudflare publica llaves de prueba que siempre aprueban.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Supabase (registro de leads) ---
# https://supabase.com/dashboard → tu proyecto → Project Settings → API.
# La service role / secret key es SOLO de servidor: nunca con prefijo NEXT_PUBLIC.

# Sal para el hash SHA-256 de la IP del lead (texto aleatorio largo, p. ej. `openssl rand -hex 32`).
LEAD_IP_HASH_SALT=

# --- Cron de Vercel (aviso diario de farmacias) ---
# Vercel lo envía como "Authorization: Bearer …" al llamar /api/cron/aviso-farmacias.
# Texto aleatorio largo, p. ej. `openssl rand -hex 32`.
CRON_SECRET=

# --- Panel /admin (directorio) ---
# Correo que recibe las fichas nuevas y el único que puede entrar al panel.
ADMIN_EMAIL=desarrollador@solucionesdys.cl
# Firma de la sesión del panel (mínimo 32 caracteres, p. ej. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=
